   "id": "riddle_order",
   "src": "JMC 2020 Q5 / 2022 Q3：想一个数，运算链逆推",
   "p": 1,
   "vars": {
    "n": [
     3,
     9
    ],
    "a": [
     2,
     3
    ],
    "b": [
     2,
     9
    ],
    "r": "n*a+b",
    "x": [
     3,
     7
    ],
    "s": [
     1,
     9
    ],
    "h": "n*x",
    "coins": "2*h+s"
   },
   "beats": [
    {
     "at": 0.2,
     "icon": "🧩",
     "intro": {
      "zh": "{who}走进店里，眨眨眼：“我要的蛋糕个数，乘 {a} 再加 {b}，正好是 {r}。猜猜我要几个？”",
      "en": "{who} winks: “Take the number of cakes I want, multiply by {a}, then add {b}. You get {r}. How many do I want?”"
     },
     "steps": [
      {
       "calc": "{r} − {b}",
       "a": "r-b",
       "q": {
        "zh": "倒着走：先把加上的 {b} 去掉。",
        "en": "Work backwards: first take away the {b}."
       }
      },
      {
       "q": {
        "zh": "再除以 {a}：{who}要几个蛋糕？",
        "en": "Now divide by {a}. How many cakes?"
       },
       "a": "n",
       "fam": "reverse"
      }
     ],
     "win": {
      "text": {
       "zh": "你把 {n} 个蛋糕装进盒子。{who}笑着说：“晚点来取，顺便付钱！”",
       "en": "You box {n} cakes. “I'll pick them up later and pay then!”"
      }
     },
     "lose": {
      "text": {
       "zh": "{who}说：“是 {n} 个啦！”还是很高兴地下了单。",
       "en": "“It's {n}!” says {who}, and orders anyway."
      }
     }
    },
    {
     "at": 0.65,
     "icon": "💰",
     "intro": {
      "zh": "{who}来取蛋糕，掏出钱包又出一题：“我钱包里的钱减去 {s}，再除以 2，正好是 {h}。”",
      "en": "{who} comes back for the cakes with another riddle: “My money minus {s}, then halved, is exactly {h}.”"
     },
     "steps": [
      {
       "calc": "{h} × 2",
       "a": "2*h",
       "q": {
        "zh": "倒回去：先乘 2。",
        "en": "Undo the halving first."
       }
      },
      {
       "q": {
        "zh": "钱包里原来有多少{money}？",
        "en": "How much money is in the wallet?"
       },
       "a": "coins",
       "fam": "reverse"
      },
      {
       "q": {
        "zh": "{n} 个蛋糕每个 {x}{money}，要找零多少？",
        "en": "{n} cakes at {x} each. How much change?"
       },
       "a": "coins-n*x",
       "fam": "money"
      }
     ],
     "win": {
      "text": {
       "zh": "找零正确！{who}留下 1 枚小费。",
       "en": "Right change! {who} leaves a 1-coin tip."
      },
      "do": [
       [
        "cash",
        "n*x+1"
       ]
      ]
     },
     "lose": {
      "text": {
       "zh": "{who}自己数了一遍，付了 {x} × {n}。",
       "en": "{who} counts it out themselves."
      },
      "do": [
       [
        "cash",
        "n*x"
       ]
      ]
     }
    }
   ]
  },
